# Copy to .env and adjust for your environment. All values shown are defaults.

# Where the app reaches Ollama. In docker-compose this is the "ollama" service name.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=300

# Require this value in the X-API-Key header on POST /api/ask. Leave unset/empty
# to run without auth (local development only — do not deploy without setting this).
API_KEY=

LOG_LEVEL=INFO
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Override to mount storage/ from elsewhere (e.g. a Docker volume).
STORAGE_DIR=
